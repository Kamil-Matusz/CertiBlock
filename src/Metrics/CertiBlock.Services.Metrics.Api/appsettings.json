{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Seq": {
      "ServerUrl": "http://localhost:5341",
      "ApiKey": "",
      "ServiceName": "Metrics-Service",
      "Environment": "Development",
      "MinimumLevel": "Information"
    }
  },
  "AllowedHosts": "*",
