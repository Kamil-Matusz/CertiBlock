  },
  "InfluxDb": {
    "Url": "http://localhost:8086",
    "Token": "my-super-secret-auth-token",
    "Organization": "certiblock",
    "Bucket": "metrics"
  },
  "Services": {
    "EthereumUrl": "http://localhost:5055/ethereum-service/",
    "PolygonUrl": "http://localhost:5056/polygon-service/"
  }
