{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    },
    "Seq": {
      "ServerUrl": "http://localhost:5341",
      "ApiKey": "",
      "ServiceName": "Gateway-Service",
      "Environment": "Development",
      "MinimumLevel": "Information"
    }
  },
  "App": {
    "AppName": "Api-Gateway"
  },
  "AllowedHosts": "*",
  "Observability": {
    "Enabled": true,
    "Endpoint": "http://localhost:4317"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },
  "Auth": {
    "Issuer": "certiBlock-issuer",
    "Audience": "certiBlock-audience",
    "SigningKey": "VhagJ82N5Yz8jhC8nU88tUuwxE35GtXNgVFY4aae"
  },
  "ReverseProxy": {
    "Routes": {
      "certificates": {
        "ClusterId": "certificate-service-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/certificate-service/{**catch-all}"
        }
      },
      "ethereum": {
        "ClusterId": "ethereum-service-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "TimeoutPolicy": "blockchain",
        "Match": {
          "Path": "/ethereum-service/{**catch-all}"
        }
      },
      "polygon": {
        "ClusterId": "polygon-service-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "TimeoutPolicy": "blockchain",
        "Match": {
          "Path": "/polygon-service/{**catch-all}"
        }
      },
      "users-sign-in": {
        "ClusterId": "users-service-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-limit",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/users-service/users/signIn",
          "Methods": [ "POST" ]
        }
      },
      "users-sign-up": {
        "ClusterId": "users-service-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "auth-limit",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/users-service/users/signUp",
          "Methods": [ "POST" ]
        }
      },
      "users": {
        "ClusterId": "users-service-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/users-service/{**catch-all}"
        }
      },
      "metrics": {
        "ClusterId": "metrics-service-cluster",
        "AuthorizationPolicy": "RequireAuth",
        "TimeoutPolicy": "default",
        "Match": {
          "Path": "/metrics-service/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "certificate-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5052" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Threshold": 3,
            "Path": "/health"
          }
        }
      },
      "ethereum-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5055" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Threshold": 4,
            "Path": "/health"
          }
        }
      },
      "polygon-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5056" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Threshold": 3,
            "Path": "/health"
          }
        }
      },
      "users-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5097" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Threshold": 3,
            "Path": "/health"
          }
        }
      },
      "metrics-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5137" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:01:00",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Threshold": 3,
            "Path": "/health"
          }
        }
      }
    }
  }
}