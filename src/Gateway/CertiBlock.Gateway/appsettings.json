{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Seq": {
      "ServerUrl": "http://localhost:5341",
      "ApiKey": "",
      "ServiceName": "Gateway-Service",
      "Environment": "Development",
      "MinimumLevel": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "certificates": {
        "ClusterId": "certificate-service-cluster",
        "AuthorizationPolicy": "AllowAnonymous",
        "Match": {
          "Path": "/api/certificates/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/certificates" }
        ]
      },
      "ethereum": {
        "ClusterId": "ethereum-service-cluster",
        "AuthorizationPolicy": "AllowAnonymous",
        "Match": {
          "Path": "/api/ethereum/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/ethereum" }
        ]
      },
      "polygon": {
        "ClusterId": "polygon-service-cluster",
        "AuthorizationPolicy": "AllowAnonymous",
        "Match": {
          "Path": "/api/polygon/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/polygon" }
        ]
      },
      "users": {
        "ClusterId": "users-service-cluster",
        "AuthorizationPolicy": "AllowAnonymous",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/users" }
        ]
      }
    },
    "Clusters": {
      "certificate-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5052/certificate-service" }
        }
      },
      "ethereum-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5055/ethereum-service" }
        }
      },
      "polygon-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5056/polygon-service" }
        }
      },
      "users-service-cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5097/users-service" }
        }
      }
    }
  }
}
